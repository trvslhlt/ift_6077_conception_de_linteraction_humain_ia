{
  "key": "pattern/one-drop",
  "kind": "pattern",
  "summary": "Reggae one drop, 1 bar: kick and rim together on 3 only, hats in swung 8ths",
  "tags": [
    "reggae",
    "one drop",
    "dub",
    "roots",
    "drums",
    "swung"
  ],
  "devices": [],
  "links": [],
