  },
  "body": [
    "Nothing on 1: the 'drop'. Around 70–80 BPM. Steppers (kick on every beat) and rockers are the busier variants."
  ],
  "pattern": {
    "type": "drums",
    "mini": "[~ ~ bd:0.9 ~, ~ ~ rim:0.85 ~, [hh:0.45 hh:0.315]*4, ~ ~ ~ ~ ~ ~ ~ oh:0.35]",
    "swing": 0.6
  },
  "apply": {
    "params": {
      "track": {
        "type": "track",
        "about": "the drum track (a kit)"
      },
      "from_bar": {
        "type": "number",
        "optional": true
      },
      "bars": {
        "type": "number",
        "optional": true
      }
    },
    "steps": [
      {
        "op": "pattern",
        "input": {
          "track": "$track",
          "from_bar": "$from_bar",
          "bars": "$bars"
        }
      }
    ]
  }
