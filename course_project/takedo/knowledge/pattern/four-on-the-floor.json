  "body": [
    "The house and disco default at 115–128 BPM. Techno often drops the clap for a rim or nothing, and the 16th hats for a ride."
  ],
  "pattern": {
    "type": "drums",
    "mini": "[[bd:0.95]*4, ~ cp:0.85 ~ cp:0.85, [~ oh:0.6]*4, [~ hh:0.3]*8]"
  },
  "apply": {
    "params": {
      "track": {
        "type": "track",
        "about": "the drum track (a kit)"
      },
      "from_bar": {
        "type": "number",
        "optional": true
      },
      "bars": {
        "type": "number",
        "optional": true
      }
    },
