  },
  "body": [
    "Felt at half the tempo (85) with the snares on the backbeat. Ghost snare before the bar line; a shaker in 16ths adds the roll."
  ],
  "pattern": {
    "type": "drums",
    "mini": "[bd:0.95 ~ ~ ~ ~ bd:0.85 ~ ~, ~ ~ ~ ~ sd:0.95 ~ ~ ~ ~ ~ ~ ~ sd:0.95 ~ ~ sd:0.35, [hh:0.55 hh:0.385]*4, ~ ~ ~ oh:0.45 ~ ~ ~ ~]"
  },
  "apply": {
    "params": {
      "track": {
        "type": "track",
        "about": "the drum track (a kit)"
      },
      "from_bar": {
        "type": "number",
        "optional": true
      },
      "bars": {
        "type": "number",
        "optional": true
      }
    },
    "steps": [
      {
        "op": "pattern",
        "input": {
          "track": "$track",
          "from_bar": "$from_bar",
          "bars": "$bars"
        }
      }
    ]
  }
}
