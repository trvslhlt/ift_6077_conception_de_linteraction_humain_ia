{
  "key": "pattern/dnb-two-step",
  "kind": "pattern",
  "summary": "Drum & bass two-step, 1 bar at 170: kick on 1 and the and of 3, snare on 2 and 4, driving 8th hats",
  "tags": [
    "drum and bass",
    "dnb",
    "jungle",
    "two-step",
    "breakbeat",
    "drums",
    "fast"
  ],
  "devices": [],
  "links": [],
  "checked": {
    "how": "written",
    "by": "claude (genre write-ups)",
